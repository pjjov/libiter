.TH libiter-hashmap 3 "February 22, 2026" libiter 
.SH NAME

.PP
\fBhashmap(K, V)\fR \- generic associative arrays

.SH DESCRIPTION

.PP
Hash maps are associative containers, storing key\-value pairs\&. Unlike \fBvector\fR, \fBhashmap\fR stores two types, one for the key and one for the value (labeled as K and V)\&.

.PP
The performance of this container heavily depends on the \fBhasher_fn\fR used\&.

.SS Casting

.PP
Because of stricter memory requirements, casting the key and value types of hashmaps should only be done when the new types have the same size and alignment as the previous ones, i\&.e\&. produce the same layout structure\&.

.PP
.SH SYNOPSIS
.P
.nf
hashmap(K, V) hashmap_init(
    type K, type V,
    hashmap_t *map,
    allocator_t *allocator
)
void hashmap_free(hashmap_t *map)
hashmap(K, V) hashmap_create(type K, type V, allocator_t *allocator)
hashmap(K, V) hashmap_with_capacity(
    type K, type V,
    size_t capacity,
    allocator_t *allocator
)
hashmap(K, V) hashmap_from_arrays(
    K *keys,
    V *values,
    size_t count,
    allocator_t *allocator
)
void hashmap_destroy(hashmap(K, V) map)
int hashmap_use_hash(hashmap(K, V) map, hash_fn *hash, hasher_fn *hasher)
int hashmap_reserve(hashmap(K, V) map, size_t count)
size_t hashmap_count(const hashmap(K, V) map)
size_t hashmap_capacity(const hashmap(K, V) map)
allocator_t *hashmap_allocator(const hashmap(K, V) map)
V *hashmap_get(const hashmap(K, V) map, const K *key)
int hashmap_set(hashmap(K, V) map, const K *key, const V *value)
int hashmap_insert(hashmap(K, V) map, const K *key, const V *value)
int hashmap_remove(hashmap(K, V) map, const K *key)
void hashmap_clear(hashmap(K, V) map)
int hashmap_fast_insert(hashmap(K, V) map, const K *key, const V *value)
int hashmap_each(hashmap(T) map, hashmap_each_fn *each, void *user)
int hashmap_filter(hashmap(T) map, hashmap_each_fn *filter, void *user)
iter(V) hashmap_iter(hashmap(K, V) map, iter_t *out)
iter(V *) hashmap_iter_ref(hashmap(K, V) map, iter_t *out)
.fi


.SH REFERENCE

.SS hashmap_init

.nf
.RS
hashmap(K, V) hashmap_init(
    type K, type V,
    hashmap_t *map,
    allocator_t *allocator
)
.RE
.fi

.PP
Initializes \fBmap\fR and casts it to \fBhashmap(K, V)\fR\&. With this function, you can allocate the hashmap object onto the stack\&. If \fBallocator\fR is \fBNULL\fR, the default one will be used instead\&. Returns \fBNULL\fR if unsuccessful\&.

.PP
You should use \fBhashmap_free\fR to free the returned hashmap's resources instead of \fBhashmap_destroy\fR when this function is used\&.


.SS hashmap_free

.nf
.RS
void hashmap_free(hashmap_t *map)
.RE
.fi

.PP
Frees all resources used by \fBmap\fR, which was initialized by \fBhashmap_init\fR beforehand, if it's not \fBNULL\fR\&.

.SS hashmap_create

.nf
.RS
hashmap(K, V) hashmap_create(type K, type V, allocator_t *allocator)
.RE
.fi

.PP
Creates a new instance of \fBhashmap(K, V)\fR, allocated with \fBallocator\fR\&. Returns \fBNULL\fR if out of memory or \fBsizeof(K) == 0\fR\&.

.PP
If \fBallocator\fR is \fBNULL\fR, the default one will be used\&.


.SS hashmap_with_capacity

.nf
.RS
hashmap(K, V) hashmap_with_capacity(
    type K, type V,
    size_t capacity,
    allocator_t *allocator
)
.RE
.fi

.PP
Creates a new instance of \fBhashmap(K, V)\fR, allocated with \fBallocator\fR, and reserves space for at least \fBcapacity\fR more items\&. Returns \fBNULL\fR if out of memory or \fBsizeof(K) == 0\fR\&.

.PP
If \fBallocator\fR is \fBNULL\fR, the default one will be used\&.


.SS hashmap_from_arrays

.nf
.RS
hashmap(K, V) hashmap_from_arrays(
    K *keys,
    V *values,
    size_t count,
    allocator_t *allocator
)
.RE
.fi

.PP
Creates a new instance of \fBhashmap(K, V)\fR, allocated with \fBallocator\fR, and inserts \fBcount\fR key\-value pairs from arrays \fBkeys\fR and \fBvalues\fR\&. Returns \fBNULL\fR if out of memory or \fBsizeof(K) == 0\fR\&.

.PP
If \fBallocator\fR is \fBNULL\fR, the default one will be used\&.


.SS hashmap_destroy

.nf
.RS
void hashmap_destroy(hashmap(K, V) map)
.RE
.fi

.PP
Frees all resources used by \fBmap\fR\&.

.PP
If \fBmap\fR is \fBNULL\fR, the function silently returns\&.


.SS hashmap_use_hash

.nf
.RS
int hashmap_use_hash(hashmap(K, V) map, hash_fn *hash, hasher_fn *hasher)
.RE
.fi

.PP
Uses the \fBhash\fR and \fBhasher\fR for storing key\-value pairs\&. This function cannot be used if items are already present in \fBmap\fR\&. Possible error codes: ITER_EINVAL\&.

.SS hashmap_reserve

.nf
.RS
int hashmap_reserve(hashmap(K, V) map, size_t count)
.RE
.fi

.PP
Reserves space to fit at least \fBcount\fR more items\&. Possible error codes: ITER_EINVAL, ITER_ENOMEM\&.

.SS hashmap_count

.nf
.RS
size_t hashmap_count(const hashmap(K, V) map)
.RE
.fi

.PP
Returns the number of items in \fBmap\fR\&.

.SS hashmap_capacity

.nf
.RS
size_t hashmap_capacity(const hashmap(K, V) map)
.RE
.fi

.PP
Returns the number of slots reserved for storing items in \fBmap\fR\&.

.SS hashmap_allocator

.nf
.RS
allocator_t *hashmap_allocator(const hashmap(K, V) map)
.RE
.fi

.PP
Returns the allocator used by \fBmap\fR\&.

.SS hashmap_get

.nf
.RS
V *hashmap_get(const hashmap(K, V) map, const K *key)
.RE
.fi

.PP
Returns the value associated with \fBkey\fR, or \fBNULL\fR if not found\&.

.SS hashmap_set

.nf
.RS
int hashmap_set(hashmap(K, V) map, const K *key, const V *value)
.RE
.fi

.PP
Sets the value associated with \fBkey\fR to \fBvalue\fR, inserting if not present\&. Possible error codes: ITER_EEXIST, ITER_EINVAL, ITER_ENOMEM\&.

.SS hashmap_insert

.nf
.RS
int hashmap_insert(hashmap(K, V) map, const K *key, const V *value)
.RE
.fi

.PP
Attempts to insert the key\-value pair if not already present\&. Possible error codes: ITER_EEXIST, ITER_EINVAL, ITER_ENOMEM\&.

.SS hashmap_remove

.nf
.RS
int hashmap_remove(hashmap(K, V) map, const K *key)
.RE
.fi

.PP
Removes the key\-value pair matched by \fBkey\fR, if found\&. Possible error codes: ITER_EINVAL, ITER_ENOENT\&.

.SS hashmap_clear

.nf
.RS
void hashmap_clear(hashmap(K, V) map)
.RE
.fi

.PP
Removes all items from \fBmap\fR, silently returning if it's \fBNULL\fR\&.

.SS hashmap_fast_insert

.nf
.RS
int hashmap_fast_insert(hashmap(K, V) map, const K *key, const V *value)
.RE
.fi

.PP
Attempts to insert the key\-value pair without checking if they have already been inserted\&. This function can break \fBmap\fR if not used carefully\&. Possible error codes: ITER_EINVAL, ITER_ENOMEM\&.

.SS hashmap_each

.nf
.RS
int hashmap_each(hashmap(T) map, hashmap_each_fn *each, void *user)
.RE
.fi

.PP
Calls the \fBeach\fR callback for each item present in \fBmap\fR, stopping if a non\-zero value is returned by one of the calls\&.

.nf
.RS
typedef int(hashmap_each_fn)(void *key, void *value, void *user);
.RE
.fi

.PP
Possible error codes: ITER_EINVAL, ITER_EINTR\&.

.SS hashmap_filter

.nf
.RS
int hashmap_filter(hashmap(T) map, hashmap_each_fn *filter, void *user)
.RE
.fi

.PP
Removes each item in \fBmap\fR for which the \fBfilter\fR callback returns a \fB0\fR\&. Possible error codes: ITER_EINVAL\&.

.SS hashmap_iter

.nf
.RS
iter(V) hashmap_iter(hashmap(K, V) map, iter_t *out)
.RE
.fi

.PP
Initializes \fBout\fR as an iterator traversing values present in \fBmap\fR\&.

.PP
Inserting items or reserving space will invalidate the returned iterator\&.


.SS hashmap_iter_ref

.nf
.RS
iter(V *) hashmap_iter_ref(hashmap(K, V) map, iter_t *out)
.RE
.fi

.PP
Initializes \fBout\fR as an iterator traversing addreses of each value present in \fBmap\fR\&.

.PP
Inserting items or reserving space will invalidate the returned iterator\&.



.SH ERRORS

For most functions that return an \fBint\fR type, \fB0\fR indicates success, while negated values of POSIX error codes indicate failure.

You should interpret returned values as:

.IP \(bu 2
\fBITER_OK\fR - Function call succeeded.
.IP \(bu 2
\fBITER_EINVAL\fR - Invalid parameter values passed.
.IP \(bu 2
\fBITER_ENOMEM\fR - Allocation error occured, e.g. out of memory.
.IP \(bu 2
\fBITER_EEXIST\fR - Key or value already exists.
.IP \(bu 2
\fBITER_ENOENT\fR - Key or value doesn't exist.
.IP \(bu 2
\fBITER_ENODATA\fR - No more items available.
.IP \(bu 2
\fBITER_ENOSYS\fR - Feature is not available.

Alongside these, boolean values \fBITER_TRUE\fR and \fBITER_FALSE\fR are defined.

